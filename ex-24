
#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main() {
    int fd;
    char text[] = "Hello UNIX";
    char buf[50] = {0};
    int n;

    fd = open("/tmp/test.txt",
              O_CREAT | O_RDWR | O_TRUNC, 0644);

    if (fd == -1) {
        perror("File error");
        return 1;
    }

    write(fd, text, sizeof(text) - 1);
    lseek(fd, 0, SEEK_SET);

    n = read(fd, buf, sizeof(buf) - 1);

    if (n >= 0) {
        buf[n] = '\0';
        printf("File content: %s\n", buf);
    }

    close(fd);
    return 0;
}
