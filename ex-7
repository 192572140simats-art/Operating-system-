
#include <stdio.h>

int main() {
    int n, i, time = 0, completed = 0, idx;
    int at[20], bt[20], wt[20], tat[20];
    int ct[20], done[20] = {0};

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Enter arrival time and burst time for P%d: ", i + 1);
        scanf("%d %d", &at[i], &bt[i]);
    }

    while (completed < n) {
        idx = -1;

        for (i = 0; i < n; i++) {
            if (at[i] <= time && !done[i]) {
                if (idx == -1 || bt[i] < bt[idx]) {
                    idx = i;
                }
            }
        }

        if (idx == -1) {
            time++;
            continue;
        }

        time += bt[idx];
        ct[idx] = time;
        tat[idx] = ct[idx] - at[idx];
        wt[idx] = tat[idx] - bt[idx];

        done[idx] = 1;
        completed++;
    }

    printf("\n-----------------------------------------------\n");
    printf("%-10s %-12s %-12s\n",
           "Process", "Waiting", "Turnaround");
    printf("-----------------------------------------------\n");

    for (i = 0; i < n; i++) {
        printf("P%-9d %-12d %-12d\n",
               i + 1, wt[i], tat[i]);
    }

    printf("-----------------------------------------------\n");

    return 0;
}
