
#include <stdio.h>
#include <stdlib.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/wait.h>
#include <unistd.h>

int main() {
    int shmid;
    char *data;
    pid_t pid;

    shmid = shmget(IPC_PRIVATE, 1024, IPC_CREAT | 0666);

    if (shmid == -1) {
        perror("shmget");
        return 1;
    }

    pid = fork();

    if (pid == 0) {
        data = (char *)shmat(shmid, NULL, 0);

        if (data == (char *)-1) {
            perror("shmat");
            exit(1);
        }

        snprintf(data, 1024, "Hello from child process!");

        shmdt(data);
        exit(0);

    } else if (pid > 0) {
        wait(NULL);

        data = (char *)shmat(shmid, NULL, 0);

        if (data == (char *)-1) {
            perror("shmat");
            shmctl(shmid, IPC_RMID, NULL);
            return 1;
        }

        printf("Message received: %s\n", data);

        shmdt(data);
        shmctl(shmid, IPC_RMID, NULL);

    } else {
        perror("fork");
        shmctl(shmid, IPC_RMID, NULL);
        return 1;
    }

    return 0;
}
