
#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>

sem_t mutex, writeLock;
int readers = 0, data = 10;

void *reader(void *arg) {
    sem_wait(&mutex);
    readers++;
    if (readers == 1)
        sem_wait(&writeLock);
    sem_post(&mutex);

    printf("Reader reads: %d\n", data);

    sem_wait(&mutex);
    readers--;
    if (readers == 0)
        sem_post(&writeLock);
    sem_post(&mutex);
    return NULL;
}

void *writer(void *arg) {
    sem_wait(&writeLock);
    data++;
    printf("Writer updates data: %d\n", data);
    sem_post(&writeLock);
    return NULL;
}

int main() {
    pthread_t r, w;
    sem_init(&mutex, 0, 1);
    sem_init(&writeLock, 0, 1);

    pthread_create(&r, NULL, reader, NULL);
    pthread_create(&w, NULL, writer, NULL);
    pthread_join(r, NULL);
    pthread_join(w, NULL);

    sem_destroy(&mutex);
    sem_destroy(&writeLock);
    return 0;
}
