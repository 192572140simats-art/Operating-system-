
#include <stdio.h>

int main() {
    int n, i, tq, time = 0, completed = 0;
    int at[20], bt[20], rem[20];
    int wt[20], tat[20], ct[20];

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Enter arrival time and burst time for P%d: ", i + 1);
        scanf("%d %d", &at[i], &bt[i]);
        rem[i] = bt[i];
    }

    printf("Enter time quantum: ");
    scanf("%d", &tq);

    if (tq <= 0) {
        printf("Time quantum must be positive.\n");
        return 1;
    }

    while (completed < n) {
        int executed = 0;

        for (i = 0; i < n; i++) {
            if (at[i] <= time && rem[i] > 0) {
                executed = 1;

                if (rem[i] > tq) {
                    time += tq;
                    rem[i] -= tq;
                } else {
                    time += rem[i];
                    rem[i] = 0;
                    ct[i] = time;
                    completed++;
                }
            }
        }

        if (!executed) {
            time++;
        }
    }

    for (i = 0; i < n; i++) {
        tat[i] = ct[i] - at[i];
        wt[i] = tat[i] - bt[i];
    }

    printf("\n-----------------------------------------------\n");
    printf("%-10s %-12s %-12s\n",
           "Process", "Waiting", "Turnaround");
    printf("-----------------------------------------------\n");

    for (i = 0; i < n; i++) {
        printf("P%-9d %-12d %-12d\n",
               i + 1, wt[i], tat[i]);
    }

    printf("-----------------------------------------------\n");

    return 0;
}
