
#include <stdio.h>
#include <string.h>

int main() {
    char files[10][20], name[20];
    int n = 0, ch, i, found;

    while (1) {
        printf("\n1.Create 2.Search 3.Display 4.Exit\n");
        scanf("%d", &ch);

        if (ch == 1) {
            printf("Enter file name: ");
            scanf("%19s", name);
            found = 0;

            for (i = 0; i < n; i++)
                if (strcmp(files[i], name) == 0)
                    found = 1;

            if (found)
                printf("File already exists\n");
            else if (n < 10) {
                strcpy(files[n++], name);
                printf("File created\n");
            } else
                printf("Directory full\n");
        }
        else if (ch == 2) {
            printf("Enter file name: ");
            scanf("%19s", name);
            found = 0;

            for (i = 0; i < n; i++)
                if (strcmp(files[i], name) == 0)
                    found = 1;

            printf(found ? "File found\n" : "File not found\n");
        }
        else if (ch == 3) {
            for (i = 0; i < n; i++)
                printf("%s\n", files[i]);
        }
        else
            break;
    }
    return 0;
}
