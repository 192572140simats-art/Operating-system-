
#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main() {
    int fd, flags;
    struct stat st;
    struct dirent *entry;
    DIR *dir;

    fd = open("/tmp/test.txt",
              O_CREAT | O_RDWR | O_TRUNC, 0644);

    if (fd == -1) {
        perror("open");
        return 1;
    }

    write(fd, "Operating System", 16);

    flags = fcntl(fd, F_GETFL);
    printf("File flags: %d\n", flags);

    lseek(fd, 0, SEEK_SET);
    printf("File position reset to beginning\n");

    if (stat("/tmp/test.txt", &st) == 0)
        printf("File size: %ld bytes\n", (long)st.st_size);

    close(fd);

    dir = opendir("/tmp");
    if (dir == NULL) {
        perror("opendir");
        return 1;
    }

    printf("Directory opened successfully\n");
    printf("Directory entries:\n");

    while ((entry = readdir(dir)) != NULL)
        printf("%s\n", entry->d_name);

    closedir(dir);
    return 0;
}
