
#include <stdio.h>
#include <stdlib.h>
int main()
{
    int a[20],n,head,size,i,j,seek=0;
    printf("Enter number of requests: ");
    scanf("%d",&n);
    printf("Enter requests: ");
    for(i=0;i<n;i++)
        scanf("%d",&a[i]);
    printf("Enter head position: ");
    scanf("%d",&head);
    printf("Enter disk size: ");
    scanf("%d",&size);

    a[n++]=head;
    a[n++]=0;
    a[n++]=size-1;

    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(a[i]>a[j])
            {
                int t=a[i];
                a[i]=a[j];
                a[j]=t;
            }

    for(i=0;i<n;i++)
        if(a[i]==head) break;

    seek+=(a[n-1]-head);
    seek+=a[n-1];
    seek+=a[i-1];

    printf("Total Seek Time = %d",seek);
    return 0;
}
